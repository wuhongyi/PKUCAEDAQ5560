# mod ch ts_offset_ns energy_low energy_high (inclusive; only listed channels change)
# Defaults for unlisted channels: 0 ns, no energy cut.
# Gates act on the full precision energy/D value, not clipped energyxia.
mod ch ts_offset ch_low ch_high
0 0 0 -1e300 1e300
1 0 0 -1e300 1e300
2 0 0 -1e300 1e300
3 0 0 -1e300 1e300
